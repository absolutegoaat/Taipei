<UserControl x:Class="Taipei.Views.AboutTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Taipei.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" 
               Source="{Binding TaipeiImage}" 
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <Grid Grid.Column="1" Margin="10">
            <StackPanel>
                <TextBlock Text="Taipei" FontSize="48" Margin="3" FontWeight="DemiBold"/>
                <TextBlock Text="A Proxy inspector, Made by absolutegoaat" 
                           Margin="0,10,0,0"
                           FontSize="14"
                           Padding="10"/>
                <TextBlock Padding="10">
                    <Hyperlink NavigateUri="https://github.com/absolutegoaat">
                        Click me to visit my profile!
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
