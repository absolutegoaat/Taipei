<UserControl x:Class="Taipei.Views.DataTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:local="clr-namespace:Taipei.Views" 
             d:DataContext="{d:DesignInstance Type=local:DataTable}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Column="0" Grid.Row="0" Header="Actions" Margin="5" Padding="5">
            <StackPanel>
                <Button Content="View Details" Margin="0,0,0,5"/>
                <Button Content="Copy URL" Margin="0,0,0,5"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="0" Grid.Row="1" Header="Search" Margin="5" Padding="5">
            <Button Content="Search Database..." Margin="5"/>
        </GroupBox>

        <DataGrid Grid.Column="1" 
                  Grid.Row="0" 
                  Grid.RowSpan="2"
                  x:Name="LogsDataGrid"
                  Margin="5"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  MouseDoubleClick="LogsDataGrid_MouseDoubleClick"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Client IP" Binding="{Binding Client_Ip}" Width="150"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80" />
                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="70" />
                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="180" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="70" />
                <DataGridCheckBoxColumn Header="HTTPS" Binding="{Binding IsHttps, Mode=OneWay}" Width="60" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="5">
            <Button x:Name="PrevPageButton" Content="Previous" Click="PrevPageButton_Click" Margin="0,0,10,0" Width="100" IsEnabled="False"/>
            <TextBlock x:Name="PageLabel" Text="Showing 0 of 0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="NextPageButton" Content="Next" Click="NextPageButton_Click" Width="100" IsEnabled="False"/>
            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" Margin="10,0,0,0"/>
        </StackPanel>

    </Grid>
</UserControl>