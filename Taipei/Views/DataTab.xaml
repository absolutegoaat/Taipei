<UserControl x:Class="Taipei.Views.DataTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Taipei.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="250" />
            <ColumnDefinition Width="*" MinWidth="250" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Column="0" 
                  Grid.Row="0"
                  Header="Total Data"
                  Margin="5">
            <StackPanel Margin="5">
                <TextBlock Text="Total Requests" FontSize="14" Foreground="Gray"/>
                <TextBlock Text="{Binding TotalRequests, TargetNullValue=—}" FontSize="32" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Total Cookies" FontSize="14" Foreground="Gray"/>
                <TextBlock Text="{Binding TotalCookies, TargetNullValue=—}" FontSize="32" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" 
          Grid.Row="0"
          Header="Status Codes"
          Margin="5">
            <StackPanel Margin="5">
                <TextBlock Text="Success (2xx)" FontSize="14" Foreground="Gray"/>
                <TextBlock Text="{Binding Total2xx, TargetNullValue=—}" FontSize="32" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Client Errors (4xx)" FontSize="14" Foreground="Gray"/>
                <TextBlock Text="{Binding Total4xx, TargetNullValue=—}" FontSize="32" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Server Errors (5xx)" FontSize="14" Foreground="Gray"/>
                <TextBlock Text="{Binding Total5xx, TargetNullValue=—}" FontSize="32" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
