<UserControl x:Class="Taipei.Windows.Views.CookiesTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taipei.Windows.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="CookiesDatagrid"
                  ItemsSource="{Binding}"
                  Margin="5"
                  Grid.Column="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionChanged="CookiesDatagrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cookie Type" Binding="{Binding CookieType}" Width="*"/>
                <DataGridTextColumn Header="Cookie Name" Binding="{Binding CookieName}" Width="*"/>
                <DataGridTextColumn Header="Cookie Value" Binding="{Binding CookieValue}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Header="Actions"
                  Margin="5"
                  Grid.Column="0"
                  Padding="5">
            <Button x:Name="CopyCookieVal"
                    Content="Copy Cookie Value"
                    VerticalAlignment="Top"
                    Click="CopyCookieVal_Click"
                    IsEnabled="False"/>
        </GroupBox>
    </Grid>
</UserControl>
