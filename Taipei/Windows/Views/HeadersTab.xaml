<UserControl x:Class="Taipei.Windows.Views.HeadersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Taipei.Windows.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <DataGrid x:Name="HeadersGrid"
                  ItemsSource="{Binding}"
                  Margin="5"
                  Grid.Column="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionChanged="HeadersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Header Type" Binding="{Binding HeaderType}" Width="*"/>
                <DataGridTextColumn Header="Header Name" Binding="{Binding HeaderName}" Width="*"/>
                <DataGridTextColumn Header="Header Value" Binding="{Binding HeaderValue}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Header="Actions"
                  Margin="5"
                  Grid.Column="0">
            <Button VerticalAlignment="Top"
                    Content="Copy Header Value"
                    x:Name="CopyHeadVal"
                    Click="CopyHeadVal_Click"
                    IsEnabled="False"/>
        </GroupBox>
    </Grid>
</UserControl>
