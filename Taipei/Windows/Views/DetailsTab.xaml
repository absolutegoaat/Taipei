<UserControl x:Class="Taipei.Windows.Views.DetailsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:local="clr-namespace:Taipei.Windows.Views"
             xmlns:conv="clr-namespace:Taipei.Windows.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullableBoolToVisibilityConverter x:Key="NullableBoolToVis"/>
        <conv:UnixDecimalToTimeConverter x:Key="UnixTime"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Details" Margin="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <TextBlock Text="Timestamp" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>

                    <TextBlock Text="Session Duration" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SessionDuration, StringFormat='{}{0} ms'}"/>

                    <Expander Header="Client Information" IsExpanded="True" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="IP" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ClientIp}"/>

                            <TextBlock Text="Port" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ClientPort}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Server Information" IsExpanded="True" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="IP" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ServerIp}"/>

                            <TextBlock Text="Port" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ServerPort}"/>

                            <TextBlock Text="SNI" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ServerSni}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="HTTP" IsExpanded="True" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="Method" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Method}"/>

                            <TextBlock Text="Scheme" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Scheme}"/>

                            <TextBlock Text="Host" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Host}"/>

                            <TextBlock Text="Port" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Port}"/>

                            <TextBlock Text="Path" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Path}"/>

                            <TextBlock Text="URL" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PrettyUrl}"
                               TextWrapping="Wrap"/>

                            <TextBlock Text="HTTP Version"/>
                            <TextBlock Text="{Binding HttpVersion}"/>

                            <TextBlock Text="Status Code" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StatusCode}"/>

                            <TextBlock Text="Status Reason" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StatusReason}"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Traffic Summary" Margin="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <TextBlock Text="Status" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusCode}"/>

                    <TextBlock Text="Status Reason" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding StatusReason}"/>

                    <Expander Header="Connection" IsExpanded="True" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="HTTPS" FontWeight="Bold"/>
                            <TextBlock Text="{Binding IsHttps}"/>

                            <TextBlock Text="Host Category" Margin="0,8,0,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HostCategory}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Timing" IsExpanded="True" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="Session Duration" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SessionDuration, StringFormat='{}{0} ms'}"/>

                            <TextBlock Text="Request Start" Margin="0,8,0,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ReqStart, Converter={StaticResource UnixTime}}"/>

                            <TextBlock Text="Response End" Margin="0,8,0,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RespEnd, Converter={StaticResource UnixTime}}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Transfer" IsExpanded="True" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="Request Size" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ReqContentLength, StringFormat='{}{0} bytes'}"/>

                            <TextBlock Text="Response Size" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RespContentLength, StringFormat='{}{0} bytes'}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>